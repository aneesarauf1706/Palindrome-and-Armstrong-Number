
#include<iostream>
using namespace std;

class Number
{
    public:
        int num;

        void input()
        {
            cout<<"Enter a number: ";
            cin>>num;
        }

        void palindrome()
        {
            int temp=num, rev=0, rem;

            while(temp>0)
            {
                rem=temp%10;
                rev=rev*10+rem;
                temp=temp/10;
            }

            if(num==rev)
                cout<<num<<" is a Palindrome Number"<<endl;
            else
                cout<<num<<" is not a Palindrome Number"<<endl;
        }

        void armstrong()
        {
            int temp=num, rem, sum=0, count=0, power;

            int n=num;

            while(n>0)
            {
                count++;
                n=n/10;
            }

            temp=num;

            while(temp>0)
            {
                rem=temp%10;
                power=1;

                for(int i=1; i<=count; i++)
                {
                    power=power*rem;
                }

                sum=sum+power;
                temp=temp/10;
            }

            if(num==sum)
                cout<<num<<" is an Armstrong Number"<<endl;
            else
                cout<<num<<" is not an Armstrong Number"<<endl;
        }
};

int main()
{
    Number obj;

    obj.input();
    obj.palindrome();
    obj.armstrong();

    return 0;
}
